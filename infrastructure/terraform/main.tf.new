terraform {
  required_version = ">= 1.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket         = "loomis-terraform-state"
    key            = "infrastructure/terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "loomis-terraform-locks"
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Environment = var.environment
      Project     = "Loomis"
      ManagedBy   = "Terraform"
    }
  }
}

# VPC
module "networking" {
  source = "./modules/networking"

  environment   = var.environment
  vpc_cidr      = "10.0.0.0/16"
  azs           = ["${var.aws_region}a", "${var.aws_region}b", "${var.aws_region}c"]
}

# EKS Cluster
module "eks" {
  source = "./modules/kubernetes"

  environment          = var.environment
  cluster_name         = "loomis-${var.environment}"
  kubernetes_version   = "1.28"
  vpc_id               = module.networking.vpc_id
  subnet_ids           = module.networking.private_subnet_ids
  node_instance_types  = ["t3.medium"]
  desired_size         = var.environment == "prod" ? 3 : 1
  min_size             = var.environment == "prod" ? 2 : 1
  max_size             = var.environment == "prod" ? 10 : 3
}

# ECR
module "ecr" {
  source = "./modules/container-registry"

  environment  = var.environment
  repository_names = ["core-service", "brain-service", "admin-dashboard"]
}

# CloudWatch
resource "aws_cloudwatch_log_group" "eks" {
  name              = "/aws/eks/loomis-${var.environment}"
  retention_in_days = 30

  tags = {
    Name = "loomis-eks-logs-${var.environment}"
  }
}
