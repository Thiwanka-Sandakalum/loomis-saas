# ──────────────────────────────────────────────────────────────────────────────
# CoreCourierService — required runtime environment variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# In production (Cloud Run / Kubernetes) inject these as secrets, not env vars.
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas (or self-hosted)
MongoDbSettings__ConnectionString=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MongoDbSettings__DatabaseName=courier_service_db

# Auth0 JWT
Auth0__Domain=https://<your-tenant>.us.auth0.com/
Auth0__Audience=https://<your-api-audience>/

# Integration URLs
Integrations__BrainService__Url=https://<brain-service-url>
Integrations__Telegram__WebhookBaseUrl=https://<your-api-url>

# Telegram secrets
Integrations__Telegram__BotToken=<telegram-bot-token>
