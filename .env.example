# Docker Compose Environment Variables
# Copy this file to .env and update with actual values
# Used by docker-compose.yml for local development

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme123
MONGO_INITDB_DATABASE=loomis

# Core Service Configuration
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=your-secret-jwt-key-change-in-production-min-32-chars
JWT_ISSUER=loomis-api
JWT_AUDIENCE=loomis-client

# Brain Service Configuration
NODE_ENV=development
OPENAI_API_KEY=sk-your-openai-api-key-here
LOG_LEVEL=debug
WORKERS=4

# Database Configuration
DB_HOST=mongodb
DB_PORT=27017
DB_USERNAME=admin
DB_PASSWORD=changeme123
DB_NAME=loomis

# Redis Configuration
REDIS_PASSWORD=redis-password-changeme

# Ports (change if conflicts)
MONGODB_PORT=27017
CORE_SERVICE_PORT=5000
BRAIN_SERVICE_PORT=8000
ADMIN_DASHBOARD_PORT=80
REDIS_PORT=6379
